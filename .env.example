# Copy to .env.local and fill in from Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SECRET_KEY=sb_secret_...

# Dev only: print sign-in codes to the `npm run dev` log instead of emailing them.
# Ignored in production builds.
DEV_LOG_AUTH_CODES=false

# Soft launch (works on Vercel too): print sign-in codes to the server log, but
# ONLY for admin guests (is_admin). Everyone else still gets an email.
# Remove once email (Resend SMTP) is set up.
LOG_ADMIN_AUTH_CODES=false

# Public base URL used in invite links / QR codes (set before printing invitations).
# Falls back to the current host if unset.
SITE_URL=
